[Unit]
Description=Forage CH independent market clock
After=forage-ch.service
Wants=forage-ch.service

[Service]
Type=simple
User=forage
Group=forage
WorkingDirectory=/opt/forage
EnvironmentFile=-/etc/forage/ch.env
Environment=PYTHONPATH=/opt/forage/src
ExecStart=/bin/bash /opt/forage/scripts/ch_watch.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forage-ch-watch

[Install]
WantedBy=multi-user.target
