# Environment template — copy to .env and fill locally. Never commit secrets.
OPENAI_API_KEY=
MODEL=gpt-4o-mini
# Optional:
# SERPER_API_KEY=

# Gen1 x402 (optional; wallet auto-generated under data/gen1/ if unset)
FORAGE_GEN1_PAY_TO=
FORAGE_GEN1_NETWORK=eip155:84532
FORAGE_GEN1_FACILITATOR=https://x402.org/facilitator
FORAGE_GEN1_RPC_URL=https://ethereum.publicnode.com
FORAGE_GEN1_HOST=127.0.0.1
FORAGE_GEN1_PORT=4021
# Isolated UK Companies House preflight (default port 4022; does not share Gen-1 clock):
# FORAGE_CH_API_KEY=
# FORAGE_CH_HOST=127.0.0.1
# FORAGE_CH_PORT=4022
# Required for CDP Bazaar indexing + Base mainnet facilitator settle/verify:
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
